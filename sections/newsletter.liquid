<section class="section newsletter">
  <div class="wrap newsletter-inner">
    <div>
      <h3>{{ section.settings.title | default: "Stay in the loop" }}</h3>
      <p>{{ section.settings.text | default: "Sign up for updates about events, projects and stories." }}</p>
    </div>
    <form action="/contact#contact_form" method="post" class="newsletter-form">
      <input type="hidden" name="form_type" value="contact">
      <input type="email" name="contact[email]" placeholder="Your email" required>
      <button class="btn cta primary" type="submit">{{ section.settings.button_label | default: "Subscribe" }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name":"Newsletter",
  "settings":[
    {"type":"text","id":"title","label":"Title","default":"Stay in the loop"},
    {"type":"textarea","id":"text","label":"Text"},
    {"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}
  ],
  "presets":[{"name":"Newsletter"}]
}
{% endschema %}

<section class="section featured-collection">
  <div class="wrap">
    <h2>{{ section.settings.title | default: "Featured Collection" }}</h2>
    <div class="grid product-grid">
      {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Featured collection",
  "settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"number","id":"limit","label":"Number of products","default":4},
    {"type":"text","id":"title","label":"Section title","default":"Featured Collection"}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}

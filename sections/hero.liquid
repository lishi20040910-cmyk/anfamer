<!-- Hero section inspired by meadowbliss.org (refined for stronger visual) -->
<section id="hero" class="hero-section hero-strong">
  <div class="wrap hero-inner">
    <div class="hero-content">
      <h1>{{ section.settings.heading | default: "Nurture Nature, Embrace Serenity" }}</h1>
      <p class="subheading">{{ section.settings.subheading | default: "Community-driven projects, wellbeing, and nature conservation." }}</p>
      <div class="hero-ctas">
        <!-- Primary CTA opens the donate modal for immediate interaction -->
        <button type="button" class="btn cta primary donate-open" data-target="#donate-modal">{{ section.settings.primary_label | default: "Donate" }}</button>
        <a href="{{ section.settings.secondary_link }}" class="btn cta ghost">{{ section.settings.secondary_label | default: "Learn More" }}</a>
      </div>
      <p class="hero-kicker muted small">{{ section.settings.kicker | default: "Community-led conservation & events" }}</p>
    </div>
    <div class="hero-media">
      {% if section.settings.media %}
        <img src="{{ section.settings.media | img_url: '1600x' }}" alt="Hero image">
      {% else %}
        <!-- Fallback: gradient block for consistent visual without an uploaded image -->
        <div class="hero-fallback"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker"},
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"text","id":"subheading","label":"Subheading"},
    {"type":"url","id":"primary_link","label":"Primary button link","default":"/collections"},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Donate"},
    {"type":"url","id":"secondary_link","label":"Secondary button link","default":"/pages/about"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Learn More"},
    {"type":"image_picker","id":"media","label":"Hero image"}
  ],
  "presets":[{"name":"Hero"}]
}
{% endschema %}

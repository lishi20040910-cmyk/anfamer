<!-- Hero section inspired by meadowbliss.org -->
<section id="hero" class="hero-section">
  <div class="wrap hero-inner">
    <div class="hero-content">
      <h1>{{ section.settings.heading | default: "Nurture Nature, Embrace Serenity" }}</h1>
      <p class="subheading">{{ section.settings.subheading | default: "Community-driven projects, wellbeing, and nature conservation." }}</p>
      <div class="hero-ctas">
        <a href="{{ section.settings.primary_link }}" class="btn cta primary">{{ section.settings.primary_label | default: "Donate" }}</a>
        <a href="{{ section.settings.secondary_link }}" class="btn cta ghost">{{ section.settings.secondary_label | default: "Learn More" }}</a>
      </div>
    </div>
    <div class="hero-media">
      {% if section.settings.media %}
        <img src="{{ section.settings.media | img_url: '1200x' }}" alt="Hero image">
      {% else %}
        <img src="{{ 'placeholder-hero.jpg' | asset_url }}" alt="Hero image">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type":"text","id":"heading","label":"Heading"},
    {"type":"text","id":"subheading","label":"Subheading"},
    {"type":"url","id":"primary_link","label":"Primary button link","default":"/collections"},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Donate"},
    {"type":"url","id":"secondary_link","label":"Secondary button link","default":"/pages/about"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Learn More"},
    {"type":"image_picker","id":"media","label":"Hero image"}
  ],
  "presets":[{"name":"Hero"}]
}
{% endschema %}

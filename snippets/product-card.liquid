<article class="product-card">
  <a href="{{ product.url }}" class="product-link">
    <div class="product-image">
      <img src="{{ product | img_url: '400x' }}" alt="{{ product.title }}">
    </div>
    <div class="product-meta">
      <h3>{{ product.title }}</h3>
      <div class="price">{{ product.price | money }}</div>
    </div>
  </a>
</article>
